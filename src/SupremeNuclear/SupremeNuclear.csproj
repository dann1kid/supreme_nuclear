<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SupremeNuclear</AssemblyName>
    <RootNamespace>SupremeNuclear</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- Переопределяется при сборке: dotnet build -p:GameDir="..." -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <ManagedDir>$(GameDir)\NuclearOption_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirage"><HintPath>$(ManagedDir)\Mirage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniTask"><HintPath>$(ManagedDir)\UniTask.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <!-- DecalProjector (URP): декали дрессинга карт (v0.154, TerrainDressing) -->
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <!-- Steam-лобби мода (v0.154, SnLobbyService): SteamMatchmaking/ELobbyType -->
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Локали мода: репозиторий locales/ -> игра BepInEx/plugins/SupremeNuclear/Locales/ -->
    <LocaleJsons Include="..\..\locales\*.json" />
    <!-- en-таблица ВШИТА в DLL (страховка установки): папку Locales/ могли не
         скопировать/потерять при обновлении одним DLL — англоязычный игрок
         оставался на русском (жалоба 2026-11-05). Файл в папке приоритетнее. -->
    <EmbeddedResource Include="..\..\locales\en.json">
      <LogicalName>SupremeNuclear.locales.en.json</LogicalName>
    </EmbeddedResource>
    <!-- Пресеты генератора карт (стили land/coast/seas/islands):
         репозиторий mapgen/ -> игра BepInEx/plugins/SupremeNuclear/MapGen/ -->
    <MapGenTemplates Include="..\..\mapgen\*.json" />
    <!-- Стратегические иконки юнитов (импорт из SupCom FA, tools/import_supcom_icons.py):
         репозиторий icons/supcom/ -> игра BepInEx/plugins/SupremeNuclear/Icons/supcom/ -->
    <IconPngs Include="..\..\icons\supcom\*.png" />
    <!-- Собственные генерированные иконки (ядерные носители/платформы, tools/make_nuke_icons.py):
         репозиторий icons/custom/ -> игра BepInEx/plugins/SupremeNuclear/Icons/custom/ -->
    <IconCustomPngs Include="..\..\icons\custom\*.png" />
    <!-- Персональный маппинг иконок (code/имя → stem): icons/overrides.json -> Icons/ -->
    <IconOverrides Include="..\..\icons\overrides.json" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' != 'false'">
    <Message Importance="high" Text="Deploy: $(TargetPath) -> $(GameDir)\BepInEx\plugins\SupremeNuclear\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\SupremeNuclear\" />
    <Copy SourceFiles="@(LocaleJsons)" DestinationFolder="$(GameDir)\BepInEx\plugins\SupremeNuclear\Locales\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MapGenTemplates)" DestinationFolder="$(GameDir)\BepInEx\plugins\SupremeNuclear\MapGen\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IconPngs)" DestinationFolder="$(GameDir)\BepInEx\plugins\SupremeNuclear\Icons\supcom\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IconCustomPngs)" DestinationFolder="$(GameDir)\BepInEx\plugins\SupremeNuclear\Icons\custom\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(IconOverrides)" DestinationFolder="$(GameDir)\BepInEx\plugins\SupremeNuclear\Icons\" SkipUnchangedFiles="true" />
  </Target>

</Project>
